{
  "name": "bagodi-frontend",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:customer": "npm run dev --workspace=@bagodi/customer-web",
    "dev:merchant": "npm run dev --workspace=@bagodi/merchant-admin",
    "dev:super-admin": "npm run dev --workspace=@bagodi/super-admin",
    "build": "npm run build --workspaces --if-present",
    "build:customer": "npm run build --workspace=@bagodi/customer-web",
    "build:merchant": "npm run build --workspace=@bagodi/merchant-admin",
    "build:super-admin": "npm run build --workspace=@bagodi/super-admin",
    "build:delivery": "npm run build --workspace=@bagodi/delivery-agent"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "openapi-fetch": "^0.17.0",
    "openapi-typescript": "^7.13.0",
    "puppeteer-core": "^25.16.0",
    "typescript": "^5.7.3"
  }
}
